rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.plan == 'Free';
      allow read: if request.auth != null && request.auth.uid == userId;
      // A client must not be able to grant itself a paid plan.
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.plan == resource.data.plan;
      allow delete: if false;
    }

    match /upgradeRequests/{requestId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.requestedPlan == 'Paid'
        && request.resource.data.status == 'pending';
      allow read, update, delete: if false;
    }
  }
}
